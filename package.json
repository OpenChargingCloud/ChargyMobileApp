{
  "name": "cloud.charging.open.chargy.mobile",
  "displayName": "ChargyMobileApp",
  "version": "0.5.0",
  "description": "Transparenzsoftware für die Elektromobilität",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile:ts": "tsc",
    "compile:sass": "sass src/scss/chargy.scss www/css/chargy.css",
    "bundle": "webpack --config webpack.config.cjs",
    "build": "cordova prepare browser",
    "browser": "cordova run browser",
    "lint": "eslint src/ts tests",
    "test": "vitest run",
    "test:typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test:typecheck && npm run compile:ts && npm run compile:sass && npm run bundle && npm run test",
    "audit": "npm audit",
    "sbom": "cyclonedx-npm --package-lock-only --omit dev --output-reproducible --validate --output-file sbom.cdx.json",
    "sbom:all": "cyclonedx-npm --package-lock-only --ignore-npm-errors --output-reproducible --validate --output-file sbom.all.cdx.json",
    "bundle:production": "node build-tools/bundleProduction.mjs",
    "docs:screenshots": "npm run bundle:production && npm run docs:screenshots:capture",
    "docs:screenshots:capture": "node build-tools/captureTrustScreenshots.mjs",
    "docs:validate:poi-live": "node build-tools/validatePoiLiveUseCaseExamples.mjs",
    "docs:screenshots:poi-live": "npm run bundle:production && npm run docs:screenshots:poi-live:capture",
    "docs:screenshots:poi-live:capture": "node build-tools/capturePoiLiveUseCaseScreenshots.mjs",
    "docs:screenshots:station-proof": "npm run bundle:production && npm run docs:screenshots:station-proof:capture",
    "docs:screenshots:station-proof:capture": "node build-tools/captureStationProofScreenshots.mjs",
    "fixtures:poi-session:generate": "node build-tools/generatePOISessionExample.mjs",
    "fixtures:poi-history:generate": "node build-tools/generateHistoricalPOIExample.mjs",
    "docs:screenshots:poi-session": "npm run bundle:production && npm run docs:screenshots:poi-session:capture",
    "docs:screenshots:poi-session:capture": "node build-tools/capturePOISessionScreenshots.mjs",
    "docs:screenshots:poi-history": "npm run bundle:production && npm run docs:screenshots:poi-history:capture",
    "docs:screenshots:poi-history:capture": "node build-tools/captureHistoricalPOIScreenshots.mjs",
    "fixtures:poi-prices:generate": "node build-tools/generatePOIPriceExample.mjs",
    "docs:screenshots:poi-prices": "npm run bundle:production && npm run docs:screenshots:poi-prices:capture",
    "docs:screenshots:poi-prices:capture": "node build-tools/capturePOIPriceScreenshots.mjs",
    "fixtures:poi-live-pilot:generate": "node build-tools/generateLivePOIExample.mjs",
    "docs:screenshots:poi-live-pilot": "npm run bundle:production && npm run docs:screenshots:poi-live-pilot:capture",
    "docs:screenshots:poi-live-pilot:capture": "node build-tools/captureLivePOIScreenshots.mjs",
    "fixtures:poi-observations:generate": "node build-tools/generatePOIObservedVersionsExample.mjs",
    "docs:screenshots:poi-observations": "npm run bundle:production && npm run docs:screenshots:poi-observations:capture",
    "docs:screenshots:poi-observations:capture": "node build-tools/capturePOIObservedVersionsScreenshots.mjs",
    "fixtures:poi-succession:generate": "node build-tools/generatePOITrustTransitionExample.mjs",
    "docs:screenshots:poi-succession": "npm run bundle:production && npm run docs:screenshots:poi-succession:capture",
    "docs:screenshots:poi-succession:capture": "node build-tools/capturePOITrustSuccessionScreenshots.mjs",
    "fixtures:poi-publication:generate": "node build-tools/generatePOIPublicationExample.mjs",
    "docs:screenshots:poi-publication": "npm run bundle:production && npm run docs:screenshots:poi-publication:capture",
    "docs:screenshots:poi-publication:capture": "node build-tools/capturePOIPublicationScreenshots.mjs"
  },
  "engines": {
    "node": ">=22.18 <27",
    "npm": ">=10"
  },
  "keywords": [
    "Chargy",
    "Transparenzsoftware",
    "Transparenz",
    "Eichrecht",
    "Elektromobilität",
    "E-Mobilität",
    "E-Mobility",
    "Ladestationen",
    "charging stations",
    "PTB"
  ],
  "author": "Achim Friedland <achim.friedland@graphdefined.com>",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@open-charging-cloud/chargy-core": "^0.18.0",
    "@open-charging-cloud/totp": "^0.3.1",
    "@open-charging-cloud/wwcp-poi": "^0.2.0",
    "@vanaheimr/cose": "^0.12.0",
    "@vanaheimr/metrological-cbor": "^0.12.0",
    "asn1.js": "^5.4.1",
    "base32-decode": "^1.0.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.6.1",
    "decimal.js": "^10.6.0",
    "elliptic": "^6.6.1",
    "leaflet": "^1.9.4",
    "leaflet.awesome-markers": "^2.0.5",
    "moment": "^2.31.0"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.16.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@oozcitak/dom": "^3.0.0",
    "@types/elliptic": "^6.4.18",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.awesome-markers": "^2.0.29",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "chargy-clipboard": "file:cordova-plugins/chargy-clipboard",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-android-permissions": "1.1.5",
    "cordova-plugin-app-version": "^0.1.14",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "eslint": "^10.14.0",
    "minimizer-webpack-plugin": "^5.14.0",
    "playwright": "1.64.1",
    "sass": "^1.107.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-app-version": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-network-information": {},
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-inappbrowser": {},
      "chargy-clipboard": {}
    },
    "platforms": [
      "ios",
      "android",
      "browser"
    ]
  }
}
