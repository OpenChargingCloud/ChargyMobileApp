{
  "name": "cloud.charging.open.chargy.mobile",
  "displayName": "ChargyMobileApp",
  "version": "0.4.0",
  "description": "Transparenzsoftware für die Elektromobilität",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile:ts": "tsc",
    "compile:sass": "sass src/scss/chargy.scss www/css/chargy.css",
    "bundle": "webpack --config webpack.config.cjs",
    "build": "cordova prepare browser",
    "browser": "cordova run browser",
    "lint": "eslint src/ts tests",
    "test": "vitest run",
    "test:typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test:typecheck && npm run compile:ts && npm run compile:sass && npm run bundle && npm run test",
    "audit": "npm audit",
    "sbom": "cyclonedx-npm --package-lock-only --omit dev --output-reproducible --validate --output-file sbom.cdx.json",
    "sbom:all": "cyclonedx-npm --package-lock-only --ignore-npm-errors --output-reproducible --validate --output-file sbom.all.cdx.json"
  },
  "engines": {
    "node": ">=22.13 <27",
    "npm": ">=10"
  },
  "keywords": [
    "Chargy",
    "Transparenzsoftware",
    "Transparenz",
    "Eichrecht",
    "Elektromobilität",
    "E-Mobilität",
    "E-Mobility",
    "Ladestationen",
    "charging stations",
    "PTB"
  ],
  "author": "Achim Friedland <achim.friedland@graphdefined.com>",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@open-charging-cloud/chargy-core": "^0.14.2",
    "@vanaheimr/cose": "^0.9.0",
    "@vanaheimr/metrological-cbor": "^0.11.0",
    "asn1.js": "^5.4.1",
    "base32-decode": "^1.0.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "decimal.js": "^10.6.0",
    "elliptic": "^6.6.1",
    "leaflet": "^1.9.4",
    "leaflet.awesome-markers": "^2.0.5",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@types/elliptic": "^6.4.18",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.awesome-markers": "^2.0.29",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "chargy-clipboard": "file:cordova-plugins/chargy-clipboard",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-browser": "^7.0.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-android-permissions": "1.1.5",
    "cordova-plugin-app-version": "^0.1.14",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "eslint": "^10.9.1",
    "minimizer-webpack-plugin": "^5.9.0",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-app-version": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-network-information": {},
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-inappbrowser": {},
      "chargy-clipboard": {}
    },
    "platforms": [
      "ios",
      "android",
      "browser"
    ]
  }
}
